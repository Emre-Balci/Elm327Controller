{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}"
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "apple",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "msvc",
            "hidden": true,
            "inherits": "base",
            "description": "MSVC (cl.exe) for x64; run from a Developer Command Prompt or PowerShell for VS 2022",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" },
            "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" }
        },
        {
            "name": "gcc-debug",
            "inherits": "linux",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "gcc-release",
            "inherits": "linux",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "g++", "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "clang-debug",
            "inherits": "linux",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "clang-release",
            "inherits": "linux",
            "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++", "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "asan",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "COMMON_SANITIZER": "address,undefined"
            }
        },
        {
            "name": "tsan",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "COMMON_SANITIZER": "thread"
            }
        },
        {
            "name": "portable",
            "inherits": "linux",
            "description": "The portable POSIX code of macOS and iOS, tested on Linux",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "COMMON_PORTABLE_POSIX": "ON",
                "COMMON_SANITIZER": "address,undefined"
            }
        },
        {
            "name": "tidy",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_BUILD_TYPE": "Debug",
                "ELM327_ENABLE_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "msvc-debug",
            "inherits": "msvc",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "msvc-release",
            "inherits": "msvc",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "msvc-asan",
            "inherits": "msvc",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "COMMON_SANITIZER": "address" }
        },
        {
            "name": "macos-debug",
            "inherits": "apple",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "macos-release",
            "inherits": "apple",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "ios",
            "inherits": "apple",
            "description": "The iOS app (iOS 15 and later, arm64), an Xcode project; set CMAKE_XCODE_ATTRIBUTE_DEVELOPMENT_TEAM to sign it",
            "generator": "Xcode",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "iOS",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "ELM327_BUILD_GUI": "ON"
            }
        },
        {
            "name": "android",
            "hidden": true,
            "inherits": "linux",
            "description": "Android NDK (ANDROID_NDK_HOME), API level 28",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": { "ANDROID_PLATFORM": "android-28", "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "android-arm64",
            "inherits": "android",
            "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
        },
        {
            "name": "android-x86_64",
            "inherits": "android",
            "description": "Static executables, so that the tests run on the Linux host",
            "cacheVariables": { "ANDROID_ABI": "x86_64", "CMAKE_EXE_LINKER_FLAGS": "-static" }
        }
    ],
    "buildPresets": [
        {
            "name": "linux",
            "hidden": true,
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "windows",
            "hidden": true,
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "darwin",
            "hidden": true,
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        { "name": "gcc-debug", "inherits": "linux", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "inherits": "linux", "configurePreset": "gcc-release" },
        { "name": "clang-debug", "inherits": "linux", "configurePreset": "clang-debug" },
        { "name": "clang-release", "inherits": "linux", "configurePreset": "clang-release" },
        { "name": "asan", "inherits": "linux", "configurePreset": "asan" },
        { "name": "tsan", "inherits": "linux", "configurePreset": "tsan" },
        { "name": "portable", "inherits": "linux", "configurePreset": "portable" },
        { "name": "tidy", "inherits": "linux", "configurePreset": "tidy" },
        { "name": "msvc-debug", "inherits": "windows", "configurePreset": "msvc-debug" },
        { "name": "msvc-release", "inherits": "windows", "configurePreset": "msvc-release" },
        { "name": "msvc-asan", "inherits": "windows", "configurePreset": "msvc-asan" },
        { "name": "android-arm64", "inherits": "linux", "configurePreset": "android-arm64" },
        { "name": "android-x86_64", "inherits": "linux", "configurePreset": "android-x86_64" },
        { "name": "macos-debug", "inherits": "darwin", "configurePreset": "macos-debug" },
        { "name": "macos-release", "inherits": "darwin", "configurePreset": "macos-release" },
        { "name": "ios", "inherits": "darwin", "configurePreset": "ios", "configuration": "Release" }
    ],
    "testPresets": [
        { "name": "base", "hidden": true, "output": { "outputOnFailure": true } },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "darwin",
            "hidden": true,
            "inherits": "base",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        { "name": "gcc-debug", "inherits": "linux", "configurePreset": "gcc-debug" },
        { "name": "gcc-release", "inherits": "linux", "configurePreset": "gcc-release" },
        { "name": "clang-debug", "inherits": "linux", "configurePreset": "clang-debug" },
        { "name": "clang-release", "inherits": "linux", "configurePreset": "clang-release" },
        { "name": "asan", "inherits": "linux", "configurePreset": "asan" },
        { "name": "tsan", "inherits": "linux", "configurePreset": "tsan" },
        { "name": "portable", "inherits": "linux", "configurePreset": "portable" },
        { "name": "msvc-debug", "inherits": "windows", "configurePreset": "msvc-debug" },
        { "name": "msvc-release", "inherits": "windows", "configurePreset": "msvc-release" },
        { "name": "msvc-asan", "inherits": "windows", "configurePreset": "msvc-asan" },
        { "name": "android-x86_64", "inherits": "linux", "configurePreset": "android-x86_64" },
        { "name": "macos-debug", "inherits": "darwin", "configurePreset": "macos-debug" },
        { "name": "macos-release", "inherits": "darwin", "configurePreset": "macos-release" }
    ]
}
